{
  "manifest_version": 3,
  "name": "HeadReels — 고개로 릴스 넘기기",
  "version": "0.1.0",
  "description": "웹캠으로 고개 자세를 인식해서 인스타그램 릴스를 손 안 대고 넘긴다. 위 보면 다음, 아래 보면 이전.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://www.instagram.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "HeadReels"
  },
  "content_scripts": [
    {
      "matches": ["https://www.instagram.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
